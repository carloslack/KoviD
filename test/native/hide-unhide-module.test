# REQUIRES: DEBUG_ONLY
# REQUIRES: NATIVE_TESTS

# RUN: bash %s > %t.log
# RUN: FileCheck-18 --input-file=%t.log %s

sleep 10
sudo insmod ../../../build/kovid.ko
lsmod | grep kovid
sudo bash -c "rm -f 3"  # Toggle proc interface
echo hide-lkm > /proc/myprocname
lsmod | grep kovid
echo unhide-lkm=2 > /proc/myprocname
sudo rmmod -f kovid

# CHECK: kovid
# CHECK-NOT: kovid
