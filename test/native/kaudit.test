# REQUIRES: DEBUG_ONLY
# REQUIRES: NATIVE_TESTS

# RUN: bash %s > %t.log
# RUN: FileCheck-18 --input-file=%t.log %s

sudo dmesg -c
sleep 10
sudo insmod ../../../build/kovid.ko
# Toggle proc interface using magic key (0x3 in DEBUG builds)
sudo bash -c "rm -f 3"
cat /proc/myprocname
echo root > /proc/myprocname
cat /proc/myprocname
# CHECK: 0

# su
# exit
sudo rmmod kovid
sudo dmesg

# CHECK: loaded.
# CHECK: unloaded.
