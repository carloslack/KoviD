# REQUIRES: DEBUG_ONLY
# REQUIRES: NATIVE_TESTS

# RUN: bash %s > %t.log
# RUN: FileCheck-18 --input-file=%t.log %s

sudo insmod ../../../build/kovid.ko
sudo bash -c "rm -f 3"  # Toggle proc interface

sudo echo get-unhidekey > /proc/myprocname

cat /proc/myprocname

echo "Deleting kovid"
sudo rmmod kovid

# In TEST_ENV=1 mode, it is always 2.
# CHECK: 2
